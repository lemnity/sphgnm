# Админка (/admin) — только в серверном режиме: next dev или next build && next start.
# Скопируйте в .env.local и задайте свои значения. .env.local в git не попадает.

# Пароль входа в админку. Без него вход отключён.
# Кабинет открыт в интернет: длинный случайный пароль, не короче 12 символов.
ADMIN_PASSWORD=

# Секрет подписи cookie сессии — случайная строка не короче 32 символов, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В production обязателен (короче 32 символов — вход отключён). Смена секрета разлогинивает всех.
ADMIN_SESSION_SECRET=

# Cookie сессии в production помечается Secure и уходит только по HTTPS.
# Пока сервер работает без HTTPS, раскомментируйте, иначе вход не сработает.
# Выключает Secure только точное значение false.
# ADMIN_COOKIE_SECURE=false

# Лимит попыток входа (10 неудач за 15 минут) считается по IP только за своим прокси.
# Ставьте 1, только если сайт открыт исключительно через nginx и тот задаёт заголовок:
#   proxy_set_header X-Real-IP $remote_addr;
# Иначе заголовок подделает кто угодно. Без флага все попытки считаются одним счётчиком.
# Независимо от флага действует общий потолок: 50 неудач за 15 минут на всех.
# ADMIN_TRUST_PROXY=1

# Заявки с формы (POST /api/lead) уходят письмом через локальный sendmail (Postfix).
# Кому слать, через запятую. Не задан — почта из блока «Контакты» в кабинете.
# LEAD_TO=sales@sphagnum.ae
# Отправитель. Домен — тот, для которого настроены SPF/DKIM.
# LEAD_FROM=Sphagnum Eco <noreply@sphagnum.ae>
# 1 — слать клиенту автоответ. Включайте после настройки SPF/DKIM,
# иначе письма на чужие адреса попадут в спам и испортят репутацию домена.
# Риск: адрес вводит посетитель, то есть кто угодно может заставить сервер написать
# любому человеку от имени домена. Поэтому в автоответе нет текста из формы — только
# обращение по имени (до 30 букв), тип проекта из списка и номер заявки, — и на адреса
# домена sphagnum.ae (и LEAD_FROM), LEAD_TO и почту из контактов он не уходит.
# Письма незнакомым людям всё равно возможны.
# LEAD_AUTOREPLY=1
# Путь к sendmail, если он не в /usr/sbin/sendmail.
# SENDMAIL_PATH=/usr/sbin/sendmail
