# Админка (/admin) — только в серверном режиме: next dev или next build && next start.
# Скопируйте в .env.local и задайте свои значения. .env.local в git не попадает.

# Пароль входа в админку. Без него вход отключён.
ADMIN_PASSWORD=

# Секрет подписи cookie сессии — длинная случайная строка, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В production обязателен. Смена секрета разлогинивает всех.
ADMIN_SESSION_SECRET=

# Cookie сессии в production помечается Secure и уходит только по HTTPS.
# Пока сервер работает без HTTPS, раскомментируйте, иначе вход не сработает.
# ADMIN_COOKIE_SECURE=false
